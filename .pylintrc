[MAIN]
py-version = 3.14
jobs = 1
persistent = no
ignore = .git,.venv,venv,build,dist,__pycache__,node_modules
ignore-patterns = ^\.#
source-roots = .

[MESSAGES CONTROL]
disable =
    C0103,
    C0201,
    C0411,
    C0412,
    E1101,
    R0801,
    R0903,
    R0914,
    R0915,
    R1710,
    W0613,
    W0703,
    W0718

[REPORTS]
output-format = text
reports = no
score = no
msg-template = {path}:{line}:{column}: {msg_id}: {msg}

[FORMAT]
max-line-length = 120
indent-string = '    '
indent-after-paren = 4
max-module-lines = 3000

[BASIC]
good-names = i,j,k,ex,id,db,fp,fd,_,x,y,z,n,m,a,b,t
no-docstring-rgx = ^_

[DESIGN]
max-args = 20
max-attributes = 30
max-bool-expr = 10
max-branches = 30
max-locals = 40
max-parents = 10
max-public-methods = 30
max-returns = 15
max-statements = 200
min-public-methods = 0

[REFACTORING]
max-nested-blocks = 8
never-returning-functions = sys.exit

[CLASSES]
defining-attr-methods = __init__,__new__,setUp,__post_init__
valid-classmethod-first-arg = cls
valid-metaclass-classmethod-first-arg = mcs

[EXCEPTIONS]
overgeneral-exceptions = builtins.BaseException,builtins.Exception

[IMPORTS]
deprecated-modules = optparse,tkinter.tix

[TYPECHECK]
contextmanager-decorators = contextlib.contextmanager
generated-members =
    requests.*,
    resp.*,
    response.*,
    proc.*,
    subprocess.*
ignore-mixin-members = yes
ignore-none = yes
ignored-classes =
    requests.Session,
    requests.Response,
    subprocess.Popen,
    optparse.Values,
    thread._local,
    _thread._local
redefining-builtins-modules = six.moves,past.builtins,future.builtins,builtins,io

[VARIABLES]
init-import = no
dummy-variables-rgx = _+$|(_[a-zA-Z0-9_]*[a-zA-Z0-9]+?$)|dummy|^ignored_|^unused_
additional-builtins =
allow-global-unused-variables = yes

[MISCELLANEOUS]
notes = FIXME,XXX,TODO
